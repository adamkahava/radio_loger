TZ=Africa/Dar_es_Salaam
SEGMENT_SECONDS=600
RETENTION_DAYS=153
RECORDINGS_PATH=./recordings
RADIO_ONE_URL=https://radioonetanzania.radioca.st/stream
CAPITAL_RADIO_URL=https://capitalradio.radioca.st/stream
EAST_AFRICA_URL=https://eatv.radioca.st/stream
# Transcode disables the MP3 bit reservoir for independent segments.
AUDIO_MODE=transcode
MP3_BITRATE=128k
ADMIN_USERNAME=admin
# Generate with scripts/configure.py. Single-quote hashes for Compose.
ADMIN_PASSWORD_HASH=''
OPERATOR_USERNAME=operator
# Set with scripts/configure.py --role operator. Blank disables this login.
OPERATOR_PASSWORD_HASH=''
OPERATOR_DOWNLOADS=true
SECRET_KEY=''
COOKIE_SECURE=true
ARCHIVE_BIND=127.0.0.1
ARCHIVE_PORT=8080
